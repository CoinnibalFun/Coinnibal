{
  "name": "@coinnibal/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client (viem) + admin CLI for the Coinnibal contracts on Robinhood Chain",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ops": "./src/ops.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "admin": "tsx src/admin.ts"
  },
  "dependencies": {
    "@coinnibal/contracts": "workspace:*",
    "@coinnibal/shared": "workspace:*",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
