{
  "name": "@elymum/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Elymum game server: simulation, rooms, settlement on chain (ElymumArena v3)",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "test:workers": "TEST_GAME_WORKERS=2 vitest run test/integration.test.ts test/workers.test.ts",
    "test:money": "ELYMUM_MONEY_SIM=1 vitest run test/money-conservation.test.ts",
    "money-sim": "tsx scripts/money-sim.ts",
    "load": "node --import tsx scripts/bench/load.ts",
    "typecheck": "tsc --noEmit",
    "integrity-sim": "tsx scripts/integrity-sim.ts",
    "arena-sim": "tsx scripts/arena-scaling-sim.ts",
    "e2e": "tsx scripts/e2e.ts",
    "nft:report": "tsx scripts/nft/report.ts",
    "nft:sheets": "tsx scripts/nft/sheets.ts"
  },
  "dependencies": {
    "@elymum/art": "workspace:*",
    "@elymum/sdk": "workspace:*",
    "@elymum/shared": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@napi-rs/canvas": "^1.0.0",
    "viem": "^2.57.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
