# ───────── Coinnibal game server ─────────
PORT=8787
HOST=0.0.0.0
# Where the journal (money owed!), leaderboards, profiles, the contracts registry, the server key (auto)
# and the site data are stored. Use a persistent volume in production.
DATA_DIR=./data
# Random secret for login tokens (openssl rand -hex 32, at least 32 bytes: the mainnet refuses to start with less).
# Empty: a generated one kept in DATA_DIR/auth-secret.
AUTH_SECRET=
# Admin sessions last this many minutes (default 120, 5..1440), are never extended by a refresh, and
# POST /api/admin/auth/revoke ends them
# ADMIN_TOKEN_TTL_MIN=120
# GET /api/admin/backup and /api/admin/migration-env (they hand out the server key) need a fresh signature of the
# admin wallet each time (POST /api/admin/secret-proof); on the mainnet they are off unless this is 1
# ADMIN_SECRET_EXPORT=
# Allowed origin(s) for REST calls, comma-separated ("*" is fine when the client is served by this server;
# sessions are bearer tokens, never cookies). Behind a separate site: CORS_ORIGIN=https://coinnibal.fun
CORS_ORIGIN=*
# Set to 1 behind a reverse proxy (uses X-Forwarded-For for per-IP limits: the right-most hop, i.e. the
# address your proxy saw; with several proxies in a chain set TRUST_PROXY_HOPS to their number, default 1)
TRUST_PROXY=0
# TRUST_PROXY_HOPS=1
# REQUIRED unless NODE_ENV=development: public base URL of this server (e.g. https://coinnibal.fun), the origin
# SIWE sign-ins are bound to and the base of the NFT metadata links (/api/nft/<id>). The server refuses to
# start without it. Only NODE_ENV=development may leave it empty (then the request's Host header is used;
# X-Forwarded-Host is never trusted for this).
PUBLIC_URL=
# Serve the built web client from this folder (single-origin deploy). Leave empty if hosting the client elsewhere.
WEB_DIST=

# Rooms (people only: practice ponds and official arenas have no bots; practice bots exist only in free custom
# rooms (the creator turns them on) and, on a testnet, in the test arenas)
# Humans per practice room (rookie and pro leagues each fill their busiest room first)
PRACTICE_CAPACITY=40
PRIVATE_ROOM_CAPACITY=20
# Humans per arena instance; a further instance (arena-<id>-<n>) opens when every instance is at the cap
ARENA_INSTANCE_CAP=50
# Arena rounds (paid arenas): the full play of a round and the closed-join window before the bell.
# The defaults are 300 and 60; the window is capped at half the play. Shorten them for a demo or a test.
# ROUND_SECONDS=300
# ROUND_JOIN_CLOSE_SECONDS=60
# The break after each bell before the next play, added on top of it (default 30: a 5:30 cycle; unset, at most a
# tenth of the play; set, at most the play)
# ROUND_BREAK_SECONDS=30
# WebSockets in all (default 1500: 8 vCPU / 16 GB). Guests use at most 80 % and are limited per IP and per subnet;
# signed-in sockets are not limited per IP, and a live arena coin's reconnect always gets in
MAX_CONNECTIONS=1500
MAX_CONNECTIONS_PER_IP=8
# WebSockets per IPv4 /24 or IPv6 /64 (default 48)
# MAX_CONNECTIONS_PER_SUBNET=48
# A WebSocket that sends no valid hello within this is closed (default 10000)
# WS_HELLO_TIMEOUT_MS=10000
# Graceful degradation under load: new free games, then new sockets and arena seats are refused while a game
# thread or the main thread is overloaded (default: on with NODE_ENV=production)
# LOAD_SHED=1
# Room worker threads (rooms run on several cores; the main thread keeps sockets, chain and journal).
# Unset: availableParallelism() - 1 (at least 1) with NODE_ENV=production, else 0 (one thread, as in dev
# and tests). 5 on an 8 vCPU VPS. See docs/ARCHITECTURE.md, "Threads".
# GAME_WORKERS=5
# GAME_WORKER_HANG_S=10

# ───────── Robinhood Chain (Arbitrum Orbit L2, gas token ETH) ─────────
# Coinnibal runs on Robinhood Chain only. CHAIN_ID picks the network: 46630 = Robinhood Chain Testnet (the
# default), 4663 = Robinhood Chain (mainnet). 31337 is a local Hardhat node for development. Any other
# value refuses to start; an RPC that serves another chain keeps the arenas off.
CHAIN_ID=46630
# Leave EVM_RPC_URL empty for practice only (no arenas, no mint).
# RPC used by the server (may contain an API key; it is never sent to browsers). It must serve CHAIN_ID.
# Public testnet RPC (rate-limited; use a provider such as Alchemy in production):
EVM_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Several RPCs, in order (a viem fallback; wins over EVM_RPC_URL): a provider first, the public RPC as fallback, e.g.
#   EVM_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/<key>,https://rpc.mainnet.chain.robinhood.com
# EVM_RPC_URLS=
# The request budget per URL: calls per second (one number, or one per EVM_RPC_URLS entry: "25,4"; default 4) and burst
# RPC_MAX_RPS=4
# RPC_BURST=8
# RPC handed to browsers (no secrets). Default: EVM_RPC_URL when it is a public Robinhood Chain RPC, else
# empty (the wallet's own RPC is used).
PUBLIC_RPC_URL=
# Blockscout explorer override (built in: explorer.testnet.chain.robinhood.com / robinhoodchain.blockscout.com)
EXPLORER_URL=
# The server's signing key: it is the arena's server authority (settlements, loot burns) and may be the
# NFT price keeper. It pays gas in ETH: low means under GAS_FLOOR_ETH (0.002) or under GAS_RUNWAY_CRITICAL_DAYS (2) of
# runway at the last day's spend (a warning under GAS_RUNWAY_WARN_DAYS, 7); logged, in /admin and /api/health.
#   auto      generated once into DATA_DIR/server-key.json (mode 0600); its address is logged and shown as
#             `serverKey` in /api/config: use it as the server authority when deploying the arena in /admin
#   0x…       a hex private key
#   /path     a file holding one
SERVER_PRIVATE_KEY=auto
# Optional overrides. Normally the addresses come from the registry the admin panel writes
# (DATA_DIR/chains/<chainId>/contracts.json) after deploying from the owner's wallet; a newly registered arena is
# picked up without a restart. The game token is NOT configured here: it is read from the arena
# (`setToken` from /admin); until it is set the server plays practice only and re-reads every 30 s.
ARENA_ADDRESS=
NFT_ADDRESS=
# Turn the token arenas on/off without touching the chain
STAKE_ENABLED=true
# Restrict stake rooms to these arena ids (empty = every enabled arena on-chain)
STAKE_ARENA_IDS=
# Display symbol of the game token (display only; the token is read on-chain, its own symbol is never shown).
# Unset: amounts say "tokens" (some env loaders expand "$NAME" inside values: quote a value that contains $)
# TOKEN_SYMBOL=
# The project's X handle by default (no @). Unset: coinnibalfun. The admin's Settings, X handle, overrides it once saved;
# a saved earlier default (elymum, elymumio: the defaults of before the rename) moves to this one on start.
# X_HANDLE=
# Unplayed tickets are cancelled with their full entry fee after this many seconds on the chain's clock (default 900;
# at once in an arena disabled, paused or closing for a re-price)
# STALE_SESSION_AFTER_S=900
# Eaten tickets (payout 0) wait this many seconds for each other: the deaths of a few seconds go out in one batch
# DEATH_SETTLE_BATCH_S=6
# Payout guard: a settlement paying a ticket more than every ticket of its round's instance put in is held for an
# admin decision (/admin -> Integrity); a settlement without that pool (crash recovery) above this many entry fees
# (default 100; 0 turns the guard off). docs/OPERATIONS.md, "The server key"
# PAYOUT_GUARD_MULTIPLE=100
# The server key's gas: floor (ETH) and runway alert levels (days at the last day's spend)
# GAS_FLOOR_ETH=0.002
# GAS_RUNWAY_WARN_DAYS=7
# GAS_RUNWAY_CRITICAL_DAYS=2
# /api/health answers 503 above this many due settlements or when the oldest is older than this (seconds)
# HEALTH_MAX_PENDING=400
# HEALTH_MAX_PENDING_AGE_S=900
# Blocks per eth_getLogs request (session and holder indexes); lower it if the RPC limits log ranges
# LOG_CHUNK_BLOCKS=10000
# Network-keyed state: the registry, journal and allowlist snapshots live in DATA_DIR/chains/<chainId>/, so the
# testnet's records stay on file when CHAIN_ID moves to mainnet (mainnet starts clean).
# Testnet RPC for "import testnet emblem holders" after the move to mainnet (default: the public testnet RPC)
# TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Testnet ETH faucet the /faucet page links to (default: faucet.testnet.chain.robinhood.com, see docs/RESEARCH.md)
# GAS_FAUCET_URL=

# ───────── NFT mint (priced in ETH at a USD target) ─────────
# Mint target in US cents (default 100; an owner setting, never published). The ETH/USD price comes from Hyperliquid's info API.
MINT_USD_CENTS=100
GAS_PRICE_URL=https://api.hyperliquid.xyz/info

# ───────── Emblem collection (docs/NFT-DESIGN.md) ─────────
# The collection size (= the NFT's max supply), the art style (vector, the default, or pixel) and the collection
# seed. Leave the seed empty: a random one is generated on first boot and committed (its hash and the
# provenance hash are public at /api/nft/provenance); it is revealed only after the mint. Never change it later.
# NFT_COLLECTION_SIZE=3333
# NFT_ART_STYLE=vector
# NFT_COLLECTION_SEED=

# ───────── Development only ─────────
# DEV_FAKE_CHAIN=1 runs an in-memory fake chain instead of Robinhood Chain: the game token starts unset
# (practice only, arenas "opening soon"); `curl -X POST localhost:8787/api/dev/token` sets it, like
# `setToken` from /admin, and the arenas open without a restart. With DEV_FAKE_TOKEN=1 it starts set.
# Then every signed-in wallet gets free arena tickets, and settlements are simulated ~2.6 s after a
# round end or death (fake 0x hashes). For local UI work and Playwright. It needs an explicit
# NODE_ENV=development, refuses to start when EVM_RPC_URL or SERVER_PRIVATE_KEY is set, and keeps its
# own DATA_DIR files (journal.dev-fake.json, leaderboards.dev-fake.json, profiles.dev-fake.json).
# Never set it on a deployed server.
#   NODE_ENV=development DEV_FAKE_CHAIN=1 DEV_FAKE_TOKEN=1 EVM_RPC_URL= SERVER_PRIVATE_KEY= pnpm dev:server
DEV_FAKE_CHAIN=
DEV_FAKE_TOKEN=

# ───────── Site and game access ─────────
# Admin wallets (comma-separated 0x addresses) allowed to use /admin and /api/admin/*, and to play
# whatever the game access is. NO default: when empty, a loud warning is logged and nobody is admin.
ADMIN_WALLETS=
# Who may play (practice, arenas, private rooms, spectating): admins | holders | public | maintenance.
# holders = wallets holding a Coinnibal NFT (balanceOf > 0, cached 15 s, re-read uncached at every arena seat) plus the admins.
# Empty: the admin's `gameAccess` setting decides (default admins).
GAME_ACCESS=
