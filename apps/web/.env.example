# Game server URL when the client is hosted separately (e.g. Vercel). Leave empty when the
# game server serves the client itself (same origin) or in `pnpm dev` (Vite proxies /ws and /api).
VITE_SERVER_URL=
# The chain the site names and prices gas in before the game server answers (a chain id from the
# `@elymum/shared` registry; default 46630, Robinhood Chain Testnet). Display only: wallets always
# switch to the chain the server reports.
VITE_CHAIN_ID=
# Optional RPC override for the browser (otherwise the server-advertised public RPC is used,
# and without one the wallet's own RPC).
VITE_RPC_URL=
# Absolute site URL for the canonical link, the Open Graph / X card tags in index.html, robots.txt and
# sitemap.xml (no trailing slash). Defaults to PUBLIC_URL, else https://elymum.io. Moving to coinnibal.fun:
# VITE_PUBLIC_URL=https://coinnibal.fun (docs/OPERATIONS.md).
VITE_PUBLIC_URL=
# The project's X handle (no @) for index.html's twitter:site and every "Follow @..." before the server's site
# settings load (the admin's Settings, X handle, wins after that). Default elymumio; coinnibal once it is live.
VITE_X_HANDLE=
# Contract pins (wallet safety): the arena, emblem NFT and game token this build trusts on its VITE_CHAIN_ID. The web
# approves and pays only the pinned arena, and checks its runtime code against the compiled contracts. Robinhood Chain
# Testnet (46630) defaults to the known testnet deployment; a mainnet (4663) build must set all three, or it signs
# nothing.
VITE_ARENA_ADDRESS=
VITE_NFT_ADDRESS=
VITE_TOKEN_ADDRESS=
# WalletConnect v2 project id (from WalletConnect Cloud; public by design). Empty: no WalletConnect option.
VITE_WALLETCONNECT_PROJECT_ID=
# Where players buy $NIBAL (the Pons swap page, https only). Empty: the "How to get $NIBAL" guide shows no link.
VITE_TOKEN_BUY_URL=
# The dollar price on the ticket sheet and the receipt is called out as old after this many hours (default 6).
VITE_PRICE_STALE_HOURS=
