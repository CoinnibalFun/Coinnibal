{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "mkdir -p .vercel-moved && printf 'Coinnibal moved to https://coinnibal.fun\\n' > .vercel-moved/index.html",
  "outputDirectory": ".vercel-moved",
  "framework": null,
  "redirects": [{ "source": "/:path*", "destination": "https://coinnibal.fun/:path*", "permanent": true }]
}
