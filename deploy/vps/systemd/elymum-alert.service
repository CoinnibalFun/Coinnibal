# The file name (elymum-*) and the /opt/elymum path are the live server's installed names, kept from before the
# rename (deploy/vps/lib.sh): a new name would install a second unit next to the running one.
[Unit]
Description=Coinnibal: alerts to Telegram (!!! log lines, /api/health, gas runway, disk) and autoheal
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/elymum/deploy/vps/alert.sh
TimeoutStartSec=50s
Nice=5
