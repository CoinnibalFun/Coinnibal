# The file name (elymum-*) is the live server's installed unit name, kept from before the rename
# (deploy/vps/lib.sh): a new name would install a second timer next to the running one.
[Unit]
Description=Coinnibal: daily backup at 04:00 (server time)

[Timer]
OnCalendar=*-*-* 04:00:00
# a backup missed while the server was off runs at the next boot
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
