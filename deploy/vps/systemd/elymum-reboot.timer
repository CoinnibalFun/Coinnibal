# The file name (elymum-*) is the live server's installed unit name, kept from before the rename
# (deploy/vps/lib.sh): a new name would install a second timer next to the running one.
[Unit]
Description=Coinnibal: at 04:30, the reboot a system update asks for and Docker Engine updates (in the round break)

[Timer]
OnCalendar=*-*-* 04:30:00
Persistent=false

[Install]
WantedBy=timers.target
