# The file name (elymum-*) is the live server's installed unit name, kept from before the rename
# (deploy/vps/lib.sh): a new name would install a second timer next to the running one.
[Unit]
Description=Coinnibal: alert check every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
