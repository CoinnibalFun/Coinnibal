# The file name (elymum-*) and the /opt/elymum path are the live server's installed names, kept from before the
# rename (deploy/vps/lib.sh): a new name would install a second unit next to the running one.
[Unit]
Description=Coinnibal: daily backup of the data volume
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/elymum/deploy/vps/backup.sh
# up to 2 h waiting for the lock (a deploy waiting out a paid ticket room), then the tar
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
