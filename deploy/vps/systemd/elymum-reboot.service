# The file name (elymum-*) and the /opt/elymum path are the live server's installed names, kept from before the
# rename (deploy/vps/lib.sh): a new name would install a second unit next to the running one.
[Unit]
Description=Coinnibal: the reboot a system update asks for, and Docker Engine updates, in a round break
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/elymum/deploy/vps/reboot.sh
# the lock (30 min at most), the round break (11 min at most) and an engine upgrade
TimeoutStartSec=60min
