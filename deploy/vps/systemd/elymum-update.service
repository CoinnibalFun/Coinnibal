# The file name (elymum-*) and the /opt/elymum path are the live server's installed names, kept from before the
# rename (deploy/vps/lib.sh): a new name would install a second unit next to the running one.
[Unit]
Description=Coinnibal: deploy the latest commit of the tracked branch
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/elymum/deploy/vps/update.sh
# a build can take a few minutes on a small VPS, and the swap waits out an open paid ticket room (up to 70 min)
TimeoutStartSec=2h
Nice=5
