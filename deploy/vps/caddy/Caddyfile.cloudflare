# Caddy behind Cloudflare (orange cloud on game.elymum.io). Use it instead of Caddyfile:
#   cp deploy/vps/caddy/Caddyfile.cloudflare deploy/vps/caddy/Caddyfile   (on the VPS, then reload Caddy)
# See deploy/vps/README.md, "Cloudflare in front".
#
# Client IP: Cloudflare connects from its own ranges and names the player in CF-Connecting-IP. Caddy trusts that
# header ONLY from the ranges below (anyone else's header is ignored) and hands the app exactly one
# X-Forwarded-For hop, the player's address, so the app keeps TRUST_PROXY=1 / TRUST_PROXY_HOPS=1 unchanged.
# A request that bypasses Cloudflare (straight to the VPS address) is seen with its own address: correct, but
# close that door with the firewall rules in the README so every request goes through Cloudflare.
#
# The ranges are Cloudflare's published list (https://www.cloudflare.com/ips/, checked 2026-11). Compare them
# once a year (they rarely change); a missing range only means those visitors share Cloudflare's address.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

# The game server's own domain and the site's (SITE_DOMAIN, default coinnibal.fun): the app serves the web client
# itself (WEB_DIST), so the site and the game share one origin. SITE_DOMAIN must differ from GAME_DOMAIN.
{$GAME_DOMAIN}, {$SITE_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	reverse_proxy app:8787 {
		# one hop, the player (from CF-Connecting-IP when the peer is Cloudflare, else the peer itself)
		header_up X-Forwarded-For {client_ip}
		flush_interval -1
		# keep WebSockets open across a Caddy config reload (update.sh reloads Caddy when this file changes);
		# without it Caddy closes every game socket at once on a reload (the default delay is 0)
		stream_close_delay 10m
	}
}

# www.<site> -> <site>
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
